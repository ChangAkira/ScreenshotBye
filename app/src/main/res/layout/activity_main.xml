<?xml version="1.0" encoding="utf-8"?>
<!--
  首页只做三件事：权限、使用引导、进设置。
  可调项全部搬到 SettingsActivity，参考仓库也是这个分法（首页 = 授权 + 一个「设置」入口）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                style="@style/BodyHint"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:text="@string/home_subtitle" />

            <TextView
                android:id="@+id/statusText"
                style="@style/BodyHint"
                android:layout_marginTop="10dp"
                android:textSize="13sp"
                android:text="@string/main_stopped" />

            <!-- 权限 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="@string/main_permissions" />

                    <LinearLayout
                        android:id="@+id/permContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/askPermsBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/home_request_perms" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/home_open_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/guideBtn"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/main_open_guide" />

            <!-- 国产 ROM 的硬限制，只在没放行时占位置 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/oemCard"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/SectionTitle"
                        android:textSize="14sp"
                        android:text="@string/home_oem_title" />

                    <TextView
                        style="@style/BodyHint"
                        android:text="@string/home_oem_body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/oemBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/home_battery_settings" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/oemAutostartBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/home_autostart_settings" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/versionText"
                style="@style/BodyHint"
                android:layout_marginTop="20dp"
                android:gravity="center" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
