<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页四块，照参考仓库的分卡方式：
    ① 启用服务（独立一卡，只有一个开关行）
    ② 识别规则 + 待确认截图
    ③ 询问与提醒（两两并排的固定档位旋钮）
    ④ 主题颜色 + 使用引导 + 事件日志 + 运行自检
  文案一律不给提示语，档位本身就把可选值摊在屏幕上了。
  删除默认交给系统的照片回收站；想要少一次系统弹窗，就在第二卡开「无感删除」（所有文件访问）。
  它只保证不弹确认框，去向本应用查不到（真删与「挪进不被索引的回收站目录」在媒体库里同一个表现），
  所以行尾只写「不弹确认」，代价写在名字后面的感叹号里。
  整页套在 NestedScrollView 里可滚动；旋钮只在确认是「拨」的手势时才抢触摸，竖直滑动让给页面滚动。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ① 启用服务：独立一卡，和参考仓库的第一块一致 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ScreenshotBye.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            style="@style/SettingRowLabel"
                            android:text="@string/main_watch_switch" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/watchSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/main_watch_switch" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ② 识别规则 + 待确认截图 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ScreenshotBye.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        style="@style/SectionTitle"
                        android:paddingHorizontal="16dp"
                        android:text="@string/main_rules" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/ruleFolder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:minHeight="44dp"
                        android:text="@string/main_rule_folder" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/ruleName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:minHeight="44dp"
                        android:text="@string/main_rule_name" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/ruleVideo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:minHeight="44dp"
                        android:text="@string/main_rule_video" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="4dp" />

                    <!-- 待确认截图：直接做成一行可点条目，不再套一层卡片 -->
                    <LinearLayout
                        android:id="@+id/pendingRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            style="@style/SettingRowLabel"
                            android:text="@string/main_pending_title" />

                        <TextView
                            android:id="@+id/pendingValue"
                            style="@style/SettingRowValue" />

                        <TextView
                            style="@style/SectionChevron"
                            android:contentDescription="@string/home_open" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:id="@+id/allFilesDivider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="4dp" />

                    <!-- 无感删除：授了「所有文件访问」就不再弹系统框；原件去向由系统定，行尾写实测结果 -->
                    <LinearLayout
                        android:id="@+id/allFilesRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            style="@style/SettingRowLabel"
                            android:layout_width="wrap_content"
                            android:layout_weight="0"
                            android:text="@string/settings_all_files" />

                        <!-- 感叹号：点开说明「不弹确认」换来的代价，别和整行的跳转混在一起 -->
                        <ImageView
                            android:id="@+id/allFilesWarn"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="2dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@string/settings_all_files_warn"
                            android:focusable="true"
                            android:padding="4dp"
                            android:src="@drawable/ic_warning"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/allFilesValue"
                            style="@style/SettingRowValue" />

                        <TextView
                            style="@style/SectionChevron"
                            android:contentDescription="@string/home_open" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ③ 询问与提醒：两两并排的固定档位旋钮 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ScreenshotBye.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="2dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.changakira.screenshotbye.ui.widget.DetentDial
                            android:id="@+id/askDial"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:dialLabel="@string/dial_ask_first"
                            app:dialPresets="2,5,15,30,90"
                            app:dialUnit="@string/unit_minutes" />

                        <com.changakira.screenshotbye.ui.widget.DetentDial
                            android:id="@+id/keepDial"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:dialLabel="@string/dial_keep_default"
                            app:dialPresets="0,1,3,5,7"
                            app:dialUnit="@string/unit_days" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.changakira.screenshotbye.ui.widget.DetentDial
                            android:id="@+id/gapDial"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:dialLabel="@string/dial_gap"
                            app:dialPresets="1,2,5,10,20"
                            app:dialUnit="@string/unit_minutes" />

                        <com.changakira.screenshotbye.ui.widget.DetentDial
                            android:id="@+id/timesDial"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:dialLabel="@string/dial_repeat_times"
                            app:dialPresets="0,1,2"
                            app:dialUnit="@string/unit_times" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ④ 主题颜色 + 使用引导 + 日志 + 自检 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ScreenshotBye.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="12dp">

                    <TextView
                        style="@style/SectionTitle"
                        android:paddingHorizontal="16dp"
                        android:text="@string/settings_theme" />

                    <LinearLayout
                        android:id="@+id/swatchRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="8dp" />

                    <LinearLayout
                        android:id="@+id/guideRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            style="@style/SettingRowLabel"
                            android:text="@string/main_open_guide" />

                        <TextView
                            style="@style/SectionChevron"
                            android:contentDescription="@string/home_open" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/logRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            style="@style/SettingRowLabel"
                            android:text="@string/main_log" />

                        <TextView
                            android:id="@+id/logValue"
                            style="@style/SettingRowValue" />

                        <TextView
                            style="@style/SectionChevron"
                            android:contentDescription="@string/home_open" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/diagRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            style="@style/SettingRowLabel"
                            android:text="@string/main_open_diag" />

                        <TextView
                            style="@style/SectionChevron"
                            android:contentDescription="@string/home_open" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/aboutRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            style="@style/SettingRowLabel"
                            android:text="@string/main_open_about" />

                        <TextView
                            style="@style/SectionChevron"
                            android:contentDescription="@string/home_open" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
