<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.ScreenshotBye.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <!--
          页面背景与状态栏/导航栏都钉死成中性的 @color/page_background，不随主题配色变化：
          主题颜色只管按钮、旋钮等控件。windowBackground 是所有页面根布局的默认底色，
          这样主页与设置页的背景都不再跟配色绑定（暗色版见 values-night/page_background）。
        -->
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:statusBarColor">@color/page_background</item>
        <item name="android:navigationBarColor">@color/page_background</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/light_status_bar</item>
        <!--
          中性层只在这里定义一次，五套配色共用：页面、卡片、文字、描边都不带色温。
          配色 style 里只留控件层（primary / secondary / tertiary / error / inversePrimary），
          换主题时变的只有按钮、旋钮、开关这些控件。与 PhotosManager 的 Palette.kt 同步。
        -->
        <item name="android:colorBackground">@color/page_background</item>
        <item name="colorOnBackground">@color/ink_on_background</item>
        <item name="colorSurface">@color/card_surface</item>
        <item name="colorOnSurface">@color/ink_on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/ink_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>
        <item name="colorSurfaceBright">@color/surface_bright</item>
        <item name="colorSurfaceDim">@color/surface_dim</item>
        <item name="colorSurfaceInverse">@color/inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/inverse_on_surface</item>
        <item name="colorOutline">@color/line_outline</item>
        <item name="colorOutlineVariant">@color/line_outline_variant</item>
        <item name="android:textColorLink">?attr/colorPrimary</item>
    </style>

