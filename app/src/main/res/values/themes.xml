        <item name="colorOnPrimary">@color/beige_onPrimary</item>
        <item name="colorPrimaryContainer">@color/beige_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/beige_onPrimaryContainer</item>
        <item name="colorSecondary">@color/beige_secondary</item>
        <item name="colorOnSecondary">@color/beige_onSecondary</item>
        <item name="colorSecondaryContainer">@color/beige_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/beige_onSecondaryContainer</item>
        <item name="colorTertiary">@color/beige_tertiary</item>
        <item name="colorOnTertiary">@color/beige_onTertiary</item>
        <item name="colorTertiaryContainer">@color/beige_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/beige_onTertiaryContainer</item>
        <item name="colorError">@color/beige_error</item>
        <item name="colorOnError">@color/beige_onError</item>
        <item name="colorErrorContainer">@color/beige_errorContainer</item>
        <item name="colorOnErrorContainer">@color/beige_onErrorContainer</item>
        <item name="colorPrimaryInverse">@color/beige_inversePrimary</item>
    </style>
    <!-- 默认配色就是米白；换主题由 ThemedActivity 在 onCreate 前 setTheme 覆盖 -->
    <style name="Theme.ScreenshotBye" parent="Theme.ScreenshotBye.Beige" />
